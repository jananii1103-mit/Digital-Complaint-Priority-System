<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<!DOCTYPE html><html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>Submit Complaint | Digital Complaint Priority System</title><link rel="stylesheet" href="${pageContext.request.contextPath}/css/style.css">
<style>
.page-wrap{max-width:1120px;margin:32px auto;padding:0 18px}.topbar{display:flex;justify-content:space-between;align-items:center;gap:16px;flex-wrap:wrap;margin-bottom:24px}.brand{font-size:1.35rem;font-weight:700;color:#163a63}.navlinks{display:flex;gap:10px;flex-wrap:wrap}.navlinks a,.btn{display:inline-block;padding:10px 14px;border-radius:9px;background:#1769aa;color:#fff;text-decoration:none;border:0;cursor:pointer;font:inherit}.panel{background:#fff;border:1px solid #dce5ee;border-radius:14px;padding:22px;margin-bottom:18px;box-shadow:0 5px 18px #17324d0d}.grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(160px,1fr));gap:14px}.metric{background:#f0f7ff;border-radius:12px;padding:16px}.metric strong{font-size:1.6rem;display:block;color:#1769aa}.form-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(240px,1fr));gap:16px}.field{display:flex;flex-direction:column;gap:7px;margin-bottom:14px}.field input,.field select,.field textarea{padding:11px;border:1px solid #bac9d8;border-radius:8px;font:inherit;width:100%;box-sizing:border-box}.field textarea{min-height:110px}.table-wrap{overflow-x:auto}table{border-collapse:collapse;width:100%;min-width:700px}th,td{text-align:left;padding:11px;border-bottom:1px solid #e3eaf1;vertical-align:top}th{background:#f0f5fa}.notice{padding:12px 14px;border-radius:8px;background:#fff4d6;margin:12px 0}.muted{color:#5d6c7c}.badge{display:inline-block;padding:4px 8px;background:#e8f2ff;border-radius:20px;font-size:.85rem}.login-card{max-width:440px;margin:7vh auto}.login-card h1{margin-top:0}.footer-note{font-size:.9rem;color:#667788;margin-top:18px}
</style></head><body><main class="page-wrap"><header class="topbar"><div class="brand">Digital Complaint Priority System</div><nav class="navlinks"><a href="${pageContext.request.contextPath}/student-dashboard">Dashboard</a><a href="${pageContext.request.contextPath}/my-complaints">My complaints</a><a href="${pageContext.request.contextPath}/LogoutServlet">Log out</a></nav></header><section class="panel"><h1>Submit a complaint</h1><p class="muted">Priority is calculated automatically by the system. You do not need to choose a severity or priority.</p><c:if test="${not empty errorMessage}"><div class="notice"><c:out value="${errorMessage}"/></div></c:if>
<form method="post" action="${pageContext.request.contextPath}/submit-complaint"><div class="field"><label for="title">Complaint title</label><input id="title" name="title" maxlength="150" value="<c:out value='${submittedTitle}'/>" required></div><div class="form-grid"><div class="field"><label for="category">Category</label><select id="category" name="category" required><option value="">Choose category</option><option value="Electrical" ${submittedCategory == 'Electrical' ? 'selected' : ''}>Electrical</option><option value="Water" ${submittedCategory == 'Water' ? 'selected' : ''}>Water</option><option value="Classroom" ${submittedCategory == 'Classroom' ? 'selected' : ''}>Classroom</option><option value="Hostel" ${submittedCategory == 'Hostel' ? 'selected' : ''}>Hostel</option><option value="Equipment" ${submittedCategory == 'Equipment' ? 'selected' : ''}>Equipment</option><option value="Cleaning and Maintenance" ${submittedCategory == 'Cleaning and Maintenance' ? 'selected' : ''}>Cleaning and Maintenance</option><option value="Other" ${submittedCategory == 'Other' ? 'selected' : ''}>Other</option></select></div><div class="field"><label for="location">Location</label><input id="location" name="location" maxlength="100" value="<c:out value='${submittedLocation}'/>" required placeholder="Building, room or area"></div></div><div class="field"><label for="description">Description</label><textarea id="description" name="description" required maxlength="3000" placeholder="Describe the issue clearly"><c:out value="${submittedDescription}"/></textarea></div><button class="btn" type="submit">Submit complaint</button></form></section></main></body></html>