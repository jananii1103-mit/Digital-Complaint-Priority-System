<!-- DCS_LOGIN_BUILD: 2026-10-21-repair-1 -->
<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<!DOCTYPE html><html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>Login | Digital Complaint Priority System</title><link rel="stylesheet" href="${pageContext.request.contextPath}/css/style.css?v=20261021-repair1">
<style>
.page-wrap{max-width:1120px;margin:32px auto;padding:0 18px}.topbar{display:flex;justify-content:space-between;align-items:center;gap:16px;flex-wrap:wrap;margin-bottom:24px}.brand{font-size:1.35rem;font-weight:700;color:#163a63}.navlinks{display:flex;gap:10px;flex-wrap:wrap}.navlinks a,.btn{display:inline-block;padding:10px 14px;border-radius:9px;background:#1769aa;color:#fff;text-decoration:none;border:0;cursor:pointer;font:inherit}.panel{background:#fff;border:1px solid #dce5ee;border-radius:14px;padding:22px;margin-bottom:18px;box-shadow:0 5px 18px #17324d0d}.grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(160px,1fr));gap:14px}.metric{background:#f0f7ff;border-radius:12px;padding:16px}.metric strong{font-size:1.6rem;display:block;color:#1769aa}.form-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(240px,1fr));gap:16px}.field{display:flex;flex-direction:column;gap:7px;margin-bottom:14px}.field input,.field select,.field textarea{padding:11px;border:1px solid #bac9d8;border-radius:8px;font:inherit;width:100%;box-sizing:border-box}.field textarea{min-height:110px}.table-wrap{overflow-x:auto}table{border-collapse:collapse;width:100%;min-width:700px}th,td{text-align:left;padding:11px;border-bottom:1px solid #e3eaf1;vertical-align:top}th{background:#f0f5fa}.notice{padding:12px 14px;border-radius:8px;background:#fff4d6;margin:12px 0}.muted{color:#5d6c7c}.badge{display:inline-block;padding:4px 8px;background:#e8f2ff;border-radius:20px;font-size:.85rem}.login-card{max-width:440px;margin:7vh auto}.login-card h1{margin-top:0}.footer-note{font-size:.9rem;color:#667788;margin-top:18px}
</style></head><body><main class="page-wrap"><section class="panel login-card"><div class="brand">Digital Complaint Priority System</div><h1>Sign in</h1><p class="muted">Log in to submit complaints or manage campus issues.</p>
<c:if test="${not empty param.error}"><div class="notice"><c:out value="${param.error}"/></div></c:if><c:if test="${not empty param.message}"><div class="notice"><c:out value="${param.message}"/></div></c:if>
<form method="post" action="${pageContext.request.contextPath}/LoginServlet"><div class="field"><label for="username">Username</label><input id="username" name="username" autocomplete="username" required maxlength="50"></div><div class="field"><label for="password">Password</label><input id="password" name="password" type="password" autocomplete="current-password" required></div><button class="btn" type="submit">Log in</button></form>
<p class="footer-note">Demo accounts: admin / password; student1 / password; student2 / password. Change these before using real data.</p></section></main></body></html>