<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<!DOCTYPE html><html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>Admin Dashboard | Digital Complaint Priority System</title><link rel="stylesheet" href="${pageContext.request.contextPath}/css/style.css">
<style>
.page-wrap{max-width:1120px;margin:32px auto;padding:0 18px}.topbar{display:flex;justify-content:space-between;align-items:center;gap:16px;flex-wrap:wrap;margin-bottom:24px}.brand{font-size:1.35rem;font-weight:700;color:#163a63}.navlinks{display:flex;gap:10px;flex-wrap:wrap}.navlinks a,.btn{display:inline-block;padding:10px 14px;border-radius:9px;background:#1769aa;color:#fff;text-decoration:none;border:0;cursor:pointer;font:inherit}.panel{background:#fff;border:1px solid #dce5ee;border-radius:14px;padding:22px;margin-bottom:18px;box-shadow:0 5px 18px #17324d0d}.grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(160px,1fr));gap:14px}.metric{background:#f0f7ff;border-radius:12px;padding:16px}.metric strong{font-size:1.6rem;display:block;color:#1769aa}.form-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(240px,1fr));gap:16px}.field{display:flex;flex-direction:column;gap:7px;margin-bottom:14px}.field input,.field select,.field textarea{padding:11px;border:1px solid #bac9d8;border-radius:8px;font:inherit;width:100%;box-sizing:border-box}.field textarea{min-height:110px}.table-wrap{overflow-x:auto}table{border-collapse:collapse;width:100%;min-width:700px}th,td{text-align:left;padding:11px;border-bottom:1px solid #e3eaf1;vertical-align:top}th{background:#f0f5fa}.notice{padding:12px 14px;border-radius:8px;background:#fff4d6;margin:12px 0}.muted{color:#5d6c7c}.badge{display:inline-block;padding:4px 8px;background:#e8f2ff;border-radius:20px;font-size:.85rem}.login-card{max-width:440px;margin:7vh auto}.login-card h1{margin-top:0}.footer-note{font-size:.9rem;color:#667788;margin-top:18px}
</style></head><body><main class="page-wrap"><header class="topbar"><div><div class="brand">Digital Complaint Priority System</div><div class="muted">Administrator dashboard</div></div><nav class="navlinks"><a href="${pageContext.request.contextPath}/admin-dashboard">Dashboard</a><a href="${pageContext.request.contextPath}/admin/export-complaints">Export CSV</a><a href="${pageContext.request.contextPath}/LogoutServlet">Log out</a></nav></header><h1>Complaint administration</h1><c:if test="${not empty param.success}"><div class="notice"><c:out value="${param.success}"/></div></c:if><c:if test="${not empty param.error}"><div class="notice"><c:out value="${param.error}"/></div></c:if>
<div class="grid"><div class="metric">Total<strong><c:out value="${totalCount}"/></strong></div><div class="metric">Pending<strong><c:out value="${pendingCount}"/></strong></div><div class="metric">Assigned<strong><c:out value="${assignedCount}"/></strong></div><div class="metric">In progress<strong><c:out value="${inProgressCount}"/></strong></div><div class="metric">Resolved<strong><c:out value="${resolvedCount}"/></strong></div><div class="metric">Critical<strong><c:out value="${criticalCount}"/></strong></div></div>
<section class="panel"><h2>All complaints (priority queue size: <c:out value="${priorityQueueSize}"/>)</h2><div class="table-wrap"><table><thead><tr><th>ID / Student</th><th>Complaint</th><th>Category / Location</th><th>Priority</th><th>Update</th></tr></thead><tbody><c:forEach var="c" items="${complaints}"><tr><td><strong><c:out value="${c.id}"/></strong><br><c:out value="${c.studentName}"/></td><td><strong><c:out value="${c.title}"/></strong><br><c:out value="${c.description}"/></td><td><c:out value="${c.category}"/><br><span class="muted"><c:out value="${c.location}"/></span></td><td><span class="badge"><c:out value="${c.priority}"/></span><br><c:out value="${c.status}"/></td><td><form method="post" action="${pageContext.request.contextPath}/admin/update-complaint"><input type="hidden" name="complaintId" value="<c:out value='${c.id}'/>"/><div class="field"><label>Status</label><select name="status" required><option value="PENDING" ${c.status == 'PENDING' ? 'selected' : ''}>Pending</option><option value="ASSIGNED" ${c.status == 'ASSIGNED' ? 'selected' : ''}>Assigned</option><option value="IN_PROGRESS" ${c.status == 'IN_PROGRESS' ? 'selected' : ''}>In progress</option><option value="RESOLVED" ${c.status == 'RESOLVED' ? 'selected' : ''}>Resolved</option></select></div><div class="field"><label>Assigned staff</label><input name="assignedStaff" maxlength="100" value="<c:out value='${c.assignedStaff}'/>" placeholder="Staff name"></div><button class="btn" type="submit">Save update</button></form></td></tr></c:forEach><c:if test="${empty complaints}"><tr><td colspan="5">No complaints found.</td></tr></c:if></tbody></table></div></section></main></body></html>